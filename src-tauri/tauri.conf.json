{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ADB Control",
  "version": "0.1.0",
  "identifier": "com.adbappcontrol.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ADB Control",
        "width": 1320,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Arabic",
          "English"
        ]
      },
      "wix": {
        "language": [
          "ar-SA",
          "en-US"
        ]
      }
    },
    "category": "Utility",
    "shortDescription": "Manage Android devices over ADB",
    "longDescription": "Open-source ADB AppControl alternative: app management, deep uninstall/restore, debloat, APK install/extract, screenshots, logcat and Arabic/English UI."
  }
}